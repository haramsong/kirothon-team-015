{
  "name": "designer",
  "description": "1인 가구 냉장고 관리 서비스의 UI/UX 설계 에이전트. Kiro에서 Figma MCP를 직접 호출해 디자인 시스템·컴포넌트·화면을 만들고 검증한다.",
  "prompt": "file:///Users/songharam/workspace/kirothon/.kiro/agents/designer.md",
  "tools": ["read", "write", "@figma"],
  "includeMcpJson": false,
  "mcpServers": {
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "design.md",
          "docs/design/**/*.md",
          "docs/design/**/*.{png,jpg,jpeg,svg,webp}"
        ],
        "effect": "ask"
      },
      {
        "capability": "fs_write",
        "match": ["**"],
        "exclude": [
          "design.md",
          "docs/design/**/*.md",
          "docs/design/**/*.{png,jpg,jpeg,svg,webp}"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "figma/whoami",
          "figma/get_metadata",
          "figma/get_design_context",
          "figma/get_screenshot",
          "figma/download_assets",
          "figma/get_variable_defs",
          "figma/get_libraries",
          "figma/search_design_system"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": ["figma/*"],
        "exclude": [
          "figma/whoami",
          "figma/get_metadata",
          "figma/get_design_context",
          "figma/get_screenshot",
          "figma/download_assets",
          "figma/get_variable_defs",
          "figma/get_libraries",
          "figma/search_design_system"
        ],
        "effect": "ask"
      }
    ]
  }
}
